---
import { EMAIL, LINKEDIN } from "../lib/site";
import { tr, lp, type Lang } from "../lib/i18n";
interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const t = tr(lang);
const [user, domain] = EMAIL.split("@");
---
<footer class="site-footer chapter-sky frame" data-chapter="sky" id="contact">
  <div class="notes">
    <p>{t("Skyler Markwell, teacher of multilingual learners and curriculum designer.", "Skyler Markwell, maestra de estudiantes multilingües y diseñadora de currículo.")}</p>
    <p>{t("Louisville, Kentucky. Open to instructional design and multilingual-learner roles.", "Louisville, Kentucky. Abierta a puestos de diseño instruccional y de enseñanza a estudiantes multilingües.")}</p>
    <a href="#top">{t("Back to top", "Volver arriba")}</a>
  </div>
  <div class="contact">
    <h2>{t("Get in touch", "Hablemos")}</h2>
    <p><a class="email-line" href={`mailto:${EMAIL}`}><span>{user}</span><span>@{domain}</span></a></p>
  </div>
  <div class="meta">
    <nav aria-label={t("Elsewhere", "En otros sitios")}>
      <a href={LINKEDIN} rel="me">LinkedIn</a>
      <a href={lp(lang, "/professional/")}>{t("Professional", "Profesional")}</a>
    </nav>
    <p>{t("Every preview on this site is a classroom material I made.", "Cada vista previa de este sitio es un material que hice para mis clases.")}</p>
    <p>Louisville, 2026</p>
  </div>
</footer>
