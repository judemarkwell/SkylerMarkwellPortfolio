---
/* Photo carousel: a scroll-snap track (native swipe on phones), one photo centred with its
   neighbours peeking in. Arrows, dots and a pause/play button are always there.
   Auto-advance: every 5 s while the carousel is on screen. It waits while a mouse is over it or
   keyboard focus is inside it, restarts its clock after any swipe, arrow or dot, and never runs
   under reduced motion. Touch never "holds" the carousel (iOS fires no leave event after a tap). */
import { photo } from "../lib/site";
import { tr, type Lang } from "../lib/i18n";

interface Item { k: string; alt: string; caption: string }
interface Props { items: Item[]; label: string; lang?: Lang }
const { items: raw, label, lang = "en" } = Astro.props;
const t = tr(lang);
const items = raw.map((it) => ({ ...it, p: photo(it.k) })).filter((it) => it.p);
const n = items.length;
---
<div class="carousel" role="region" aria-roledescription="carousel" aria-label={label}>
  <div class="cr-track" id="cr-track" tabindex="0" aria-label={`${label}: ${t("swipe, scroll or use the buttons below", "desliza o usa los botones de abajo")}`}>
    {items.map((it, i) => (
      <figure class:list={["cr-slide", { active: i === 0 }]} role="group" aria-roledescription="slide" aria-label={`${i + 1} ${t("of", "de")} ${n}`} data-i={i}>
        <img src={it.p!.src} srcset={it.p!.srcset} sizes="(min-width: 960px) 42rem, 78vw" width={it.p!.width} height={it.p!.height} alt={it.alt} loading={i < 3 ? "eager" : "lazy"} decoding="async" draggable="false" />
        <figcaption>{it.caption}</figcaption>
      </figure>
    ))}
  </div>
  <div class="cr-controls">
    <button type="button" class="cr-btn" id="cr-prev" aria-label={t("Previous photo", "Foto anterior")}>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <div class="cr-dots" role="group" aria-label={t("Choose a photo", "Elige una foto")}>
      {items.map((it, i) => (
        <button type="button" class="cr-dot" data-i={i} aria-label={`${t("Photo", "Foto")} ${i + 1} ${t("of", "de")} ${n}`} aria-current={i === 0 ? "true" : "false"}></button>
      ))}
    </div>
    <span class="cr-count" id="cr-count" aria-hidden="true">1 / {n}</span>
    <button type="button" class="cr-btn" id="cr-next" aria-label={t("Next photo", "Foto siguiente")}>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button type="button" class="cr-btn cr-toggle" id="cr-toggle" aria-label={t("Pause slideshow", "Pausar las fotos")} data-state="playing" data-pause={t("Pause slideshow", "Pausar las fotos")} data-play={t("Play slideshow", "Reproducir las fotos")}>
      <svg class="i-pause" viewBox="0 0 20 20" aria-hidden="true"><rect x="5.5" y="4.5" width="3" height="11" rx="1" fill="currentColor" /><rect x="11.5" y="4.5" width="3" height="11" rx="1" fill="currentColor" /></svg>
      <svg class="i-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4.8v10.4a.8.8 0 0 0 1.2.7l8-5.2a.8.8 0 0 0 0-1.4l-8-5.2A.8.8 0 0 0 7 4.8Z" fill="currentColor" /></svg>
    </button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>(".carousel");
  if (root) {
    const track = root.querySelector<HTMLElement>("#cr-track")!;
    const slides = [...root.querySelectorAll<HTMLElement>(".cr-slide")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>(".cr-dot")];
    const count = root.querySelector<HTMLElement>("#cr-count")!;
    const toggle = root.querySelector<HTMLButtonElement>("#cr-toggle")!;
    const n = slides.length;
    const DELAY = 5000;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let current = 0;
    let playing = !reduced;
    let mouseOver = false;   // a real mouse is over the carousel
    let keyFocus = false;    // keyboard focus is inside the carousel
    let onScreen = false;
    let lastMove = performance.now();
    let steering = false;    // a button-driven scroll is in flight
    let steerTimer = 0;

    const mark = (k: number) => {
      current = k;
      slides.forEach((s, j) => s.classList.toggle("active", j === k));
      dots.forEach((d, j) => d.setAttribute("aria-current", String(j === k)));
      count.textContent = `${k + 1} / ${n}`;
    };

    // Which slide is closest to the middle of the track.
    const nearest = () => {
      const t = track.getBoundingClientRect(), mid = t.left + t.width / 2;
      let best = 0, bestD = Infinity;
      slides.forEach((s, k) => {
        const r = s.getBoundingClientRect(), d = Math.abs(r.left + r.width / 2 - mid);
        if (d < bestD) { bestD = d; best = k; }
      });
      return best;
    };

    const scrollToSlide = (k: number, smooth: boolean) => {
      const s = slides[k], t = track.getBoundingClientRect(), r = s.getBoundingClientRect();
      track.scrollTo({ left: track.scrollLeft + (r.left + r.width / 2) - (t.left + t.width / 2), behavior: smooth ? "smooth" : "auto" });
    };

    // Buttons and the timer: mark the target straight away, then glide there.
    const go = (i: number) => {
      const k = ((i % n) + n) % n;
      const wrap = (current === n - 1 && k === 0) || (current === 0 && k === n - 1);
      mark(k);
      lastMove = performance.now();
      steering = true;
      clearTimeout(steerTimer);
      steerTimer = window.setTimeout(() => { steering = false; }, 900);
      // Wrapping from the last photo to the first jumps instead of rewinding past every photo.
      scrollToSlide(k, !reduced && !wrap);
    };

    // Swipes and trackpad scrolls: follow the track, and restart the clock.
    let raf = 0;
    track.addEventListener("scroll", () => {
      if (steering) return;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const k = nearest();
        if (k !== current) mark(k);
        lastMove = performance.now();
      });
    }, { passive: true });
    track.addEventListener("scrollend", () => { steering = false; const k = nearest(); if (k !== current) mark(k); });
    track.addEventListener("pointerdown", () => { steering = false; lastMove = performance.now(); }, { passive: true });

    root.querySelector("#cr-prev")!.addEventListener("click", () => go(current - 1));
    root.querySelector("#cr-next")!.addEventListener("click", () => go(current + 1));
    dots.forEach((d) => d.addEventListener("click", () => go(+d.dataset.i!)));
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); go(current + 1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); go(current - 1); }
    });

    const setPlaying = (v: boolean) => {
      playing = v;
      toggle.dataset.state = v ? "playing" : "paused";
      toggle.setAttribute("aria-label", v ? toggle.dataset.pause! : toggle.dataset.play!);
      lastMove = performance.now();
    };
    toggle.addEventListener("click", () => setPlaying(!playing));
    setPlaying(playing);

    // Only a mouse or keyboard focus holds the slideshow; a finger tap never does.
    root.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") mouseOver = true; });
    root.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") mouseOver = false; });
    root.addEventListener("focusin", (e) => { keyFocus = (e.target as HTMLElement).matches(":focus-visible"); });
    root.addEventListener("focusout", () => { keyFocus = false; });

    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; lastMove = performance.now(); }, { threshold: 0.35 }).observe(root);
    document.addEventListener("visibilitychange", () => { lastMove = performance.now(); });
    addEventListener("resize", () => scrollToSlide(current, false));

    mark(0);
    if (!reduced) {
      window.setInterval(() => {
        if (!playing || mouseOver || keyFocus || !onScreen || document.hidden) { lastMove = performance.now(); return; }
        if (performance.now() - lastMove >= DELAY) go(current + 1);
      }, 200);
    }
  }
</script>
