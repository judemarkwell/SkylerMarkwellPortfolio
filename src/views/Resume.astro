---
import Base from "../layouts/Base.astro";
import { EMAIL, LINKEDIN } from "../lib/site";
import { tr, type Lang } from "../lib/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
---
<Base lang={lang} title={t("Resume · Skyler Markwell", "Currículum · Skyler Markwell")} description={t("Resume of Skyler Markwell, curriculum developer and teacher of multilingual learners in Louisville, Kentucky.", "Currículum de Skyler Markwell, diseñadora de currículo y maestra de estudiantes multilingües en Louisville, Kentucky.")} current="professional" chapter="lime">
  <section class="chapter-lime frame page-head" data-chapter="lime">
    <h1>{t("Resume", "Currículum")}</h1>
    <p>{t("Curriculum developer and educator with four years designing instructional frameworks for multilingual and high-need learners.", "Diseñadora de currículo y educadora con cuatro años creando marcos de instrucción para estudiantes multilingües y con altas necesidades.")}</p>
    <p class="contact-line"><a href={`mailto:${EMAIL}`}>{EMAIL}</a> · <a href={LINKEDIN}>LinkedIn</a> · Louisville, Kentucky</p>
  </section>
  <section class="chapter-paper frame" data-chapter="paper">
    <div class="prose">
      <h2>{t("Experience", "Experiencia")}</h2>
      <h3>{t("Teacher of multilingual learners, ECE and health education", "Maestra de estudiantes multilingües, educación especial y salud")}</h3>
      <p>{t("ESL Newcomer Academy, Louisville · January 2026 to present", "ESL Newcomer Academy, Louisville · enero de 2026 a la fecha")}</p>
      <ul>
        <li>{t("Design tailored curricula for high-need learners, balancing rapid schedules with long-term goals to ensure concept mastery.", "Diseño currículos a la medida para estudiantes con altas necesidades, equilibrando calendarios acelerados con metas a largo plazo para asegurar el dominio de los conceptos.")}</li>
        <li>{t("Run weekly performance-coaching check-ins to review progress with students and adapt their learning pathways.", "Hago reuniones semanales con los estudiantes para revisar su progreso y adaptar su camino de aprendizaje.")}</li>
        <li>{t("Elected to the Collaboration Leadership Team; poll staff, advocate for operational improvements with administration, and collaborate across departments.", "Electa al Equipo de Liderazgo Colaborativo: consulto al personal, propongo mejoras operativas a la administración y colaboro entre departamentos.")}</li>
      </ul>
      <h3>{t("Instructional lead and career coach", "Líder instructiva y orientadora profesional")}</h3>
      <p>{t("SummerWorks Program, Louisville · June to August 2026", "Programa SummerWorks, Louisville · junio a agosto de 2026")}</p>
      <ul>
        <li>{t("Taught recent graduates in an intensive summer program: workforce readiness, career transition skills, resume writing and professional communication.", "Enseñé a recién graduados en un programa intensivo de verano: preparación para el trabajo, transición profesional, redacción de currículum y comunicación profesional.")}</li>
      </ul>
      <h3>{t("Teacher of multilingual learners and program lead", "Maestra de estudiantes multilingües y líder del programa")}</h3>
      <p>{t("Marnel C. Moorman K–8 School · September 2022 to January 2026", "Marnel C. Moorman K–8 School · septiembre de 2022 a enero de 2026")}</p>
      <ul>
        <li>{t("Used performance data to show program impact and advocate for continued funding, retaining instructional roles across a six-person department.", "Usé datos de desempeño para mostrar el impacto del programa y defender su financiamiento, conservando los puestos de un departamento de seis personas.")}</li>
        <li>{t("Designed tracking frameworks to monitor student progress and district compliance, and exited 25 students from language services through targeted intervention.", "Diseñé sistemas de seguimiento del progreso y del cumplimiento del distrito, y logré que 25 estudiantes salieran de los servicios de idioma con intervenciones específicas.")}</li>
        <li>{t("Led a team of six educators and assistants, managing schedules and resource allocation to ensure daily coverage for 100% of my caseload.", "Dirigí un equipo de seis educadores y asistentes, organizando horarios y recursos para cubrir cada día al 100% de mis estudiantes.")}</li>
        <li>{t("Led a data-cleansing initiative that audited records for 225 students, from their first entry into the country to the present day.", "Dirigí una revisión de datos que auditó los expedientes de 225 estudiantes, desde su llegada al país hasta hoy.")}</li>
        <li>{t("Ensured 100% of families were onboarded to our digital communication platform.", "Me aseguré de que el 100% de las familias se unieran a nuestra plataforma de comunicación digital.")}</li>
      </ul>
      <h2>{t("Education", "Educación")}</h2>
      <ul>
        <li><strong>{t("Master of Arts in Teaching, English as a Second Language", "Maestría en Enseñanza, inglés como segundo idioma")}</strong>, Asbury University, 2025. {t("Cross-cultural communication, instructional scaffolding, curriculum design, applied linguistics.", "Comunicación intercultural, andamiaje instruccional, diseño curricular, lingüística aplicada.")}</li>
        <li><strong>{t("Bachelor of Science, Elementary Education and Exceptional Child Education (LBD)", "Licenciatura en educación primaria y educación especial (LBD)")}</strong>, Western Kentucky University, 2022. {t("PBIS and MTSS, individualized assessment and progress tracking.", "PBIS y MTSS, evaluación individualizada y seguimiento del progreso.")}</li>
      </ul>
      <h2>{t("Licenses and training", "Licencias y formación")}</h2>
      <ul>
        <li>{t("Kentucky professional teaching licenses: ESL, Learning and Behavior Disorders, Elementary P–5", "Licencias profesionales de enseñanza de Kentucky: ESL, trastornos del aprendizaje y de la conducta, primaria de preescolar a 5.º")}</li>
        <li>{t("Trained in restorative practices", "Formación en prácticas restaurativas")}</li>
        <li>{t("UFLI literacy intervention training, 2025", "Capacitación en intervención de lectoescritura UFLI, 2025")}</li>
        <li>{t("Kentucky Numeracy Counts Academy (OVEC), expected 2027", "Kentucky Numeracy Counts Academy (OVEC), prevista para 2027")}</li>
        <li>{t("Google Certified Educator, Level 2, 2020", "Educadora certificada por Google, nivel 2, 2020")}</li>
      </ul>
      <h2>{t("Skills", "Habilidades")}</h2>
      <ul>
        <li>{t("Curriculum architecture, scope and sequence, scaffolding and differentiation, AI-assisted content authoring", "Arquitectura curricular, alcance y secuencia, andamiaje y diferenciación, creación de contenido con apoyo de IA")}</li>
        <li>{t("Progress monitoring, team leadership, stakeholder and family communication, multilingual learner support", "Seguimiento del progreso, liderazgo de equipos, comunicación con familias y comunidad, apoyo a estudiantes multilingües")}</li>
        <li>{t("Canva, digital learning and communication platforms; conversational Spanish", "Canva, plataformas digitales de aprendizaje y comunicación; español conversacional")}</li>
      </ul>
    </div>
  </section>
</Base>
