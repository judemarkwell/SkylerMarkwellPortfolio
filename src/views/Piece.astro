---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Figure from "../components/Figure.astro";
import { previewsFor, download } from "../lib/site";
import { tr, lp, kindLabel, type Lang, type WorkItem } from "../lib/i18n";

interface Props { lang: Lang; entry: WorkItem; prev: WorkItem; next: WorkItem }
const { lang, entry, prev, next } = Astro.props;
const t = tr(lang);
const { Content } = await render(entry.body);
const d = entry.data;
const pages = previewsFor(entry.id);
const hero = pages[0];
const file = download(entry.id);
---
<Base lang={lang} title={`${d.title} · Skyler Markwell`} description={d.lede} current="work" chapter="desk">
  <section class="chapter-desk frame piece-top" data-chapter="desk">
    <a class="back" href={lp(lang, "/#work")}>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      {t("Back to the desk", "Volver al escritorio")}
    </a>
    <div class="piece-grid">
      <div>
        {hero ? (
          <span class="paper hero-paper" style={`view-transition-name: sheet-${entry.id}`}>
            <img id="hero-img" src={hero.src} width={hero.width} height={hero.height} alt={d.alts[0]} />
          </span>
        ) : (
          <span class="paper hero-paper blank-sheet" style={`aspect-ratio: 8.5 / 11; view-transition-name: sheet-${entry.id}`}>{t("Preview coming soon", "Vista previa próximamente")}</span>
        )}
        {pages.length > 1 && (
          <ul class="thumbs" aria-label={t("Pages", "Páginas")}>
            {pages.map((p, k) => (
              <li><button type="button" aria-current={k === 0 ? "true" : "false"} aria-label={`${t("Show page", "Ver página")} ${k + 1}: ${d.alts[k] ?? ""}`} data-src={p.src} data-w={p.width} data-h={p.height} data-alt={d.alts[k] ?? ""}><img src={p.src} alt="" loading="lazy" /></button></li>
            ))}
          </ul>
        )}
        {file && (
          <p class="dl-row">
            <a class="btn dl-btn" href={file.href} download>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {t("Download PDF", "Descargar PDF")}
            </a>
            <span class="dl-size">{file.size}</span>
          </p>
        )}
        {lang === "es" && <p class="dl-note">El documento original está en el idioma en que lo usé con mis estudiantes.</p>}
      </div>
      <div class="piece-copy">
        <h1>{d.title}</h1>
        <p class="lede">{d.lede}</p>
        <dl class="piece-facts">
          <dt>{t("Kind of work", "Tipo de trabajo")}</dt><dd>{kindLabel(lang, d.kind)}</dd>
          <dt>{t("Made for", "Hecho para")}</dt><dd>{d.madeFor}</dd>
          <dt>{t("Format", "Formato")}</dt><dd>{d.format}</dd>
          <dt>{t("Languages", "Idiomas")}</dt><dd>{d.languages}</dd>
        </dl>
        {d.why && (
          <aside class="sticky" aria-labelledby="why">
            <h2 id="why">{t("Why I made it", "Por qué lo hice")}</h2>
            <p>{d.why}</p>
          </aside>
        )}
      </div>
    </div>
  </section>
  <section class="chapter-paper frame" data-chapter="paper">
    {d.photos.length > 0 && (
      <div class="in-class">
        <h2>{t("In the classroom", "En el salón")}</h2>
        {d.photos.map((ph) => <Figure k={ph.key} alt={ph.alt} caption={ph.caption} sizes="(min-width: 960px) 900px, 100vw" />)}
      </div>
    )}
    <div class="prose">
      <Content />
    </div>
    <nav class="nextprev" aria-label={t("More work", "Más trabajos")}>
      <a href={lp(lang, `/work/${prev.id}/`)}><span class="d">{t("Previous", "Anterior")}</span><span class="t">{prev.data.title}</span></a>
      <a class="next" href={lp(lang, `/work/${next.id}/`)}><span class="d">{t("Next", "Siguiente")}</span><span class="t">{next.data.title}</span></a>
    </nav>
  </section>
</Base>

<script>
  const hero = document.getElementById("hero-img") as HTMLImageElement | null;
  const thumbs = document.querySelectorAll<HTMLButtonElement>(".thumbs button");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  thumbs.forEach((b) => b.addEventListener("click", () => {
    if (!hero) return;
    const swap = () => {
      hero.src = b.dataset.src!; hero.width = +b.dataset.w!; hero.height = +b.dataset.h!; hero.alt = b.dataset.alt!;
      thumbs.forEach((x) => x.setAttribute("aria-current", String(x === b)));
    };
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !reduced) doc.startViewTransition(swap); else swap();
  }));

  // Flip cards (Spanish vocabulary)
  document.querySelectorAll<HTMLElement>(".flipcards").forEach((box) => {
    const cards: [string, string, string][] = JSON.parse(box.dataset.cards || "[]");
    const backLabel = box.dataset.backLabel || "Español";
    box.innerHTML = cards.map(([en, es, cat]) =>
      `<button type="button" class="card" aria-pressed="false"><span class="inner"><span class="face en-face" lang="en">${en}<small>${cat}</small></span><span class="face es-face" lang="es" aria-hidden="true">${es}<small>${backLabel}</small></span></span></button>`).join("");
    box.querySelectorAll<HTMLButtonElement>(".card").forEach((c) => c.addEventListener("click", () => {
      const on = c.getAttribute("aria-pressed") !== "true";
      c.setAttribute("aria-pressed", String(on));
      c.querySelector(".en-face")!.setAttribute("aria-hidden", String(on));
      c.querySelector(".es-face")!.setAttribute("aria-hidden", String(!on));
    }));
  });
</script>
