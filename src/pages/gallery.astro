---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Sheets from "../components/Sheets.astro";
import Figure from "../components/Figure.astro";
import { u, previewsFor, photo } from "../lib/site";

const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const kinds = ["Curriculum design", "Assessment design", "Lesson design", "Family engagement", "Classroom systems", "Teacher resources"] as const;
const groups = kinds.map((k) => ({ kind: k, items: all.filter((w) => w.data.kind === k) })).filter((g) => g.items.length);
const tour = photo("classroom-tour");

const photos = [
  { k: "grateful-board", alt: "Hallway board titled Grateful in Every Language: a paper tree whose leaves are student sentences", caption: "Grateful in Every Language: students finished “I am thankful for…” in English, Spanish, Arabic, Somali, Swahili, Pashto and Kinyarwanda." },
  { k: "access-exit", alt: "Students holding certificates under a We're Multilingual banner", caption: "My students after passing the ACCESS test and exiting English learner services." },
  { k: "wellness-board", alt: "Classroom board titled Our World in Wellness with a world map and culture cards", caption: "Our World in Wellness, from my health classroom." },
  { k: "grad-flowers", alt: "Me with a graduate in a blue gown holding flowers", caption: "Graduation day for one of my students, the first in her family to finish high school." },
  { k: "math-dominoes", alt: "A student's hand writing numbers next to dominoes on a whiteboard", caption: "Number work with dominoes." },
  { k: "grad-cert", alt: "Me beside a 12th grade student holding a certificate", caption: "After a 12th grade Defense of Learning at the Newcomer Academy." },
  { k: "thank-you", alt: "A second grade class with a thank-you sign for Ms. Markwell", caption: "A second grade class celebrating the day I came back." },
  { k: "kycec-poster", alt: "My research poster on peer tutoring for English learners", caption: "My KYCEC 2022 poster: The Effect of Peer Tutoring on ELL Students’ Academic Achievement." },
  { k: "math-whiteboard", alt: "Student whiteboard with domino pictures labeled 3, 8, 9 and 6", caption: "Showing the thinking before the answer." },
  { k: "pumpkin-patch", alt: "Me and two teachers with students at a pumpkin farm", caption: "A fall field trip with my students." },
  { k: "tesol-2025", alt: "Me with four colleagues on the pier in Long Beach", caption: "With colleagues at TESOL 2025 in Long Beach." },
  { k: "asbury-grad", alt: "Me in cap and gown at Asbury University", caption: "Master of Arts in Teaching, Asbury University, 2025." },
  { k: "wku-grad", alt: "Me in a graduation gown holding a WKU Alumni flag", caption: "Graduating from Western Kentucky University, 2022." },
];
---
<Base title="Gallery · Skyler Markwell" description="All of Skyler Markwell's classroom materials and photos from her classrooms." current="gallery" chapter="sky">
  <section class="chapter-sky frame page-head" data-chapter="sky">
    <h1>Gallery</h1>
    <p>Everything I’ve shared here, sorted by the kind of work, plus photos from my classrooms.</p>
    <nav class="gallery-jump" aria-label="On this page">
      <a href="#all-work">All my work</a>
      <a href="#photos">Photos</a>
    </nav>
  </section>

  <section class="chapter-desk frame gallery-work" data-chapter="desk" id="all-work" aria-labelledby="all-work-title">
    <h2 id="all-work-title">All my work</h2>
    {groups.map((g) => (
      <div class="gw-group">
        <h3>{g.kind}</h3>
        <ul class="gw-grid">
          {g.items.map((w) => (
            <li>
              <a class="piece gw-piece" href={u(`/work/${w.id}/`)}>
                <Sheets slug={w.id} layout="single" tilt={0} pages={previewsFor(w.id)} />
                <span class="label"><span class="name">{w.data.title}</span><span class="meta">{w.data.madeFor}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="chapter-night frame gallery-photos" data-chapter="night" id="photos" aria-labelledby="photos-title">
    <div class="room-head">
      <h2 id="photos-title">Photos</h2>
      <p>Picture supports on every wall, flags from home countries, and the students and colleagues who make the work worth it.</p>
    </div>
    <div class="masonry">
      {tour && (
        <figure class="photo room-video">
          <video id="tour" muted loop playsinline preload="metadata" poster={tour.poster} width={tour.width} height={tour.height} aria-label="A slow pan across my classroom: the door, encouraging posters, a clock, and standing tables under string lights">
            <source src={tour.video} type="video/mp4" />
          </video>
          <button type="button" class="vid-toggle" id="tour-toggle" aria-pressed="false">Pause</button>
          <figcaption>My classroom.</figcaption>
        </figure>
      )}
      {photos.map((ph) => <Figure k={ph.k} alt={ph.alt} caption={ph.caption} sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 100vw" />)}
    </div>
  </section>
</Base>

<script>
  // Classroom loop: plays muted while on screen, never autoplays under reduced motion, always pausable.
  const tour = document.getElementById("tour") as HTMLVideoElement | null;
  const btn = document.getElementById("tour-toggle") as HTMLButtonElement | null;
  if (tour && btn) {
    const set = (playing: boolean) => { btn.textContent = playing ? "Pause" : "Play"; btn.setAttribute("aria-pressed", String(!playing)); };
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && btn.dataset.user !== "paused") tour.play().then(() => set(true)).catch(() => set(false));
        else if (!e.isIntersecting) tour.pause();
      }).observe(tour);
    } else set(false);
    btn.addEventListener("click", () => {
      if (tour.paused) { btn.dataset.user = ""; tour.play().then(() => set(true)).catch(() => {}); }
      else { btn.dataset.user = "paused"; tour.pause(); set(false); }
    });
  }
</script>
