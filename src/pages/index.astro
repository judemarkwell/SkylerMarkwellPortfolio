---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Sheets from "../components/Sheets.astro";
import { u, previewsFor, headshot, photo } from "../lib/site";
import Figure from "../components/Figure.astro";
import Carousel from "../components/Carousel.astro";

const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((w) => w.data.featured);
const bySlug = Object.fromEntries(all.map((w) => [w.id, w]));
const portrait = headshot();
const intro = photo("intro-video");

// The live thing: a learner finishes the sentence, and the piece made for them is lifted.
const frames = [
  { end: "ask for a break", who: "A student who doesn't have the English words yet.", slug: "coping-poster" },
  { end: "show what I know before I can write it", who: "A student whose writing hasn't caught up with their thinking.", slug: "columbus" },
  { end: "understand my child's test scores", who: "A parent who reads Spanish.", slug: "access-faqs" },
  { end: "talk with a newcomer on day one", who: "A teacher who doesn't speak Spanish.", slug: "spanish-vocabulary" },
  { end: "learn health in my new language", who: "A high school newcomer.", slug: "health" },
  { end: "solve a problem with my class", who: "A newcomer practicing English in a circle.", slug: "restorative-circles" },
].map((f) => ({ ...f, title: bySlug[f.slug].data.title, href: u(`/work/${f.slug}/`), img: previewsFor(f.slug)[0] }));
const first = frames[0];

const designs = [
  { big: "Courses", small: "Newcomer Health, 7 units", slug: "health" },
  { big: "Assessments", small: "Tasks, rubrics, probes", slug: "columbus" },
  { big: "Family guides", small: "In English and Spanish", slug: "access-faqs" },
  { big: "Class systems", small: "PBIS, circles, check-outs", slug: "class-expectations" },
  { big: "Lessons", small: "In three languages", slug: "compare-contrast" },
  { big: "Teacher tools", small: "Cards, guides, stems", slug: "spanish-vocabulary" },
];
---
<Base
  title="Skyler Markwell, teacher and curriculum designer"
  description="Courses, assessments, family guides and classroom systems designed for multilingual learners by Skyler Markwell, Louisville, Kentucky."
  chapter="paper"
>
  <section class="hero" data-chapter="paper" aria-labelledby="name">
    <div class="field-top"></div>
    <div class="field-bottom" data-chapter="orange"></div>
    <h1 class="hero-title" id="name">
      <span class="ink above"><span>Skyler</span><span>Markwell</span></span>
      <span class="ink below" aria-hidden="true"><span>Skyler</span><span>Markwell</span></span>
    </h1>
    <p class="hero-sub">Teacher of multilingual learners and curriculum designer. I build learning for people still learning English, and for the families and teachers around them.</p>
  </section>


  <section class="chapter-paper frame define" data-chapter="paper" aria-labelledby="define-title">
    <div class="define-head rise">
      <h2 id="define-title">By definition</h2>
      <p class="define-text">
        Adaptable educator and <a href="#d-advocate" class="term t-advocate">advocate</a>, skilled in
        <a href="#d-curriculum" class="term t-curriculum">ground-up curriculum development</a> and
        <a href="#d-problem" class="term t-problem">problem solving</a>. I thrive in
        <a href="#d-collab" class="term t-collab">collaborative environments</a> where I can empower individuals to reach their full potential.
      </p>
    </div>
    <div class="define-grid rise">
      <article id="d-advocate" class="def t-advocate">
        <h3>Advocate</h3>
        <ul>
          <li>Letters to families and to my district: <a href={u("/work/access-faqs/")}>ACCESS FAQs</a>, <a href={u("/work/nti-packet/")}>NTI letter</a>, <a href={u("/work/district-letter/")}>principal selection letter</a></li>
          <li>Training for teachers: <a href={u("/research/#tesol")}>TESOL station</a>, <a href={u("/work/read-to-self/")}>Read to Self guide</a>, <a href={u("/work/spanish-vocabulary/")}>Spanish vocabulary cards</a></li>
          <li>Made sure 100% of families were onboarded to our digital communication platform</li>
        </ul>
      </article>
      <article id="d-curriculum" class="def t-curriculum">
        <h3>Ground-up curriculum</h3>
        <ul>
          <li><a href={u("/work/health/")}>Newcomer Health scope and sequence</a>: seven skills-based units built from scratch</li>
          <li><a href={u("/work/health/")}>Our World in Wellness</a> bulletin board from the same course</li>
        </ul>
      </article>
      <article id="d-problem" class="def t-problem">
        <h3>Problem solving</h3>
        <ul>
          <li>Data and spreadsheets: <a href={u("/work/progress-tracker/")}>IEP goal progress tracker</a></li>
          <li>Exited 25 students from English learner services</li>
          <li>Led a team of 6, managing schedules and resource allocation to ensure daily coverage for 100% of my caseload</li>
          <li>Led a data-cleansing initiative that audited records for 225 students, from their first entry into the country to the present day</li>
        </ul>
      </article>
      <article id="d-collab" class="def t-collab">
        <h3>Collaborative</h3>
        <ul>
          <li>Co-teaching: <a href={u("/work/compare-contrast/")}>compare and contrast lesson</a> taught in a general education class</li>
          <li>Elected to the Collaboration Leadership Team at the ESL Newcomer Academy</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="chapter-orange frame" data-chapter="orange" aria-labelledby="finish-title">
    <div class="finish">
      <div class="rise">
        <h2 id="finish-title">Finish the sentence</h2>
        <p class="statement" id="statement" aria-live="polite">I can <span class="blank" id="blank">{first.end}</span>.</p>
        <p class="who" id="who">{first.who}</p>
        <ul class="choices" id="choices" aria-label="Choose how the sentence ends">
          {frames.map((f, i) => (
            <li><button type="button" aria-pressed={i === 0 ? "true" : "false"} data-end={f.end} data-who={f.who} data-slug={f.slug} data-title={f.title} data-href={f.href} data-img={f.img?.src ?? ""} data-w={f.img?.width ?? ""} data-h={f.img?.height ?? ""}>{f.end}</button></li>
          ))}
        </ul>
      </div>
      <a class="made-this rise" id="made-this" href={first.href}>
        {first.img && <span class="paper sheet-pic"><img id="made-img" src={first.img.src} width={first.img.width} height={first.img.height} alt="" /></span>}
        <span class="caption">Made for them: <strong id="made-title">{first.title}</strong></span>
      </a>
    </div>
  </section>

  <section class="chapter-paper frame snapshots" data-chapter="paper" aria-labelledby="snap-title">
    <div class="snap-copy rise">
      <h2 id="snap-title">Snapshots</h2>
      <p>Me, my students, and a few days I’m proud of. Swipe or use the arrows to look around.</p>
    </div>
    <Carousel label="Snapshots" items={[
      { k: "headshot", alt: "Me, smiling, in a denim jacket", caption: "I am currently one of two teachers in the entire state of Kentucky teaching students with disabilities, ages 12–21, at a specialized school for multilingual learners." },
      { k: "grad-flowers", alt: "Me with a graduate in a blue gown holding flowers", caption: "Graduation day for one of my students, the first in her family to finish high school." },
      { k: "access-exit", alt: "Students holding certificates under a We're Multilingual banner", caption: "I exited 25 students from English learner services. Here are some of them with their certificates after passing the ACCESS test." },
      { k: "kycec-skyler", alt: "Me kneeling beside my research poster", caption: "Presenting my peer-tutoring research at KYCEC in Louisville, 2022." },
      { k: "thank-you", alt: "A second grade class with a thank-you sign for Ms. Markwell", caption: "A second grade class celebrating the day I came back." },
      { k: "asbury-grad", alt: "Me in cap and gown at Asbury University", caption: "Finishing my Master of Arts in Teaching at Asbury University, 2025." },
      { k: "grad-cert", alt: "Me beside a 12th grade student holding a certificate", caption: "A 20-year-old student I taught passed his Defense of Learning and came back to thank me!" },
      { k: "tesol-2025", alt: "Me with four colleagues on the pier in Long Beach", caption: "With colleagues at the TESOL convention in Long Beach, 2025." },
      { k: "pumpkin-patch", alt: "Me and two teachers with students at a pumpkin farm", caption: "My elementary students seeing a pumpkin patch for the first time." },
      { k: "wku-grad", alt: "Me in a graduation gown holding a WKU Alumni flag", caption: "Graduating from Western Kentucky University, 2022." },
      { k: "coworkers-dinner", alt: "Me with six co-workers smiling in a restaurant selfie", caption: "Dinner with my co-workers." },
      { k: "coworkers-kycec", alt: "Me with three fellow educators in a hotel lobby", caption: "With fellow educators at the KYCEC conference in Louisville, 2022." },
      { k: "staff-photo", alt: "A whole school staff in green shirts posing in a gym", caption: "With my whole school staff, everyone in green." },
      { k: "wku-mascot", alt: "Me in a red dress with WKU's mascot, Big Red", caption: "With Big Red at Western Kentucky University." },
    ]} />
  </section>

  <section id="work" aria-labelledby="work-title">
    <div class="chapter-sky frame" data-chapter="sky">
      <div class="section-head rise">
        <h2 id="work-title">On the desk</h2>
        <p>A sample of what I’ve made for real classrooms. Pick up a sheet to see it up close.</p>
      </div>
    </div>
    <div class="chapter-desk frame desk-surface" data-chapter="desk">
      <ul class="desk rise">
        {featured.map((w, i) => (
          <li class={i === 0 ? "feature" : undefined}>
            <a class="piece" href={u(`/work/${w.id}/`)} data-slug={w.id}>
              <Sheets slug={w.id} layout={w.data.layout} tilt={w.data.tilt} pages={previewsFor(w.id)} pairLabel={w.data.pairLabel} />
              <span class="label"><span class="name">{w.data.title}</span><span class="meta">{w.data.kind} · {w.data.languages}</span></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="to-gallery rise"><a href={u("/gallery/")}>See all my work and more photos in the gallery <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="chapter-night frame poster" data-chapter="night" aria-labelledby="design-title">
    <h2 id="design-title">What I design</h2>
    <ul class="rise">
      {designs.map((d) => (
        <li><a href={u(`/work/${d.slug}/`)}><span class="big">{d.big}</span><span class="small">{d.small}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="chapter-lime frame" data-chapter="lime" id="about" aria-labelledby="about-title">
    <div class="about">
      <h2 id="about-title" class="rise"><span>About me</span></h2>
      <div class="row">
        <div class="facts-side">
          {portrait && <img src={portrait.src} width={portrait.width} height={portrait.height} alt="Me, smiling, in a denim jacket" loading="lazy" />}
          <dl>
            <div><dt>Based in</dt><dd>Louisville, Kentucky</dd></div>
            <div><dt>Teaching since</dt><dd>2022</dd></div>
            <div><dt>Languages</dt><dd>English, conversational Spanish</dd></div>
            <div><dt>Trained in</dt><dd>Restorative practices</dd></div>
          </dl>
        </div>
        <div>
          <p class="lead">I’ve taught ages 5–21, all with varying levels of English language proficiency and background knowledge. I’ve co-taught with other teachers in mixed groups, and I’ve taught in isolated settings with high-needs students. I enjoy helping all learners exceed what they thought possible.</p>
          <blockquote>
            <p>I have since learned that the process is the most important piece.</p>
            <cite>From my 2026 Insight to Action reflection, on teaching math</cite>
          </blockquote>
          {intro && (
            <figure class="photo intro-video">
              <video controls playsinline preload="none" poster={intro.poster} width={intro.width} height={intro.height} aria-label="Me in a pink jacket, outdoors in the snow, talking about the kind of teacher I wanted to be">
                <source src={intro.video} type="video/mp4" />
              </video>
              <figcaption>When I first started student teaching, I recorded what kind of teacher I wanted to be.</figcaption>
            </figure>
          )}
        </div>
      </div>
      <div class="row">
        <Figure k="asbury-grad" class="grad" sizes="(min-width: 900px) 25vw, 70vw" alt="Me in cap and gown at my Asbury University graduation" caption="Master of Arts in Teaching, Asbury University, 2025." />
        <div class="record">
          <div>
            <h3>Experience</h3>
            <ul>
              <li><span>Teacher of multilingual learners, ECE and Health, ESL Newcomer Academy</span><span class="y">2026–</span></li>
              <li><span>Instructional lead and career coach, SummerWorks</span><span class="y">2026</span></li>
              <li><span>Teacher of multilingual learners and program lead, Marnel C. Moorman K–8</span><span class="y">2022–26</span></li>
              <li><span>Elected to the Collaboration Leadership Team, Newcomer Academy</span><span class="y">2026</span></li>
              <li><span>Attended the TESOL International Convention, Long Beach</span><span class="y">2025</span></li>
              <li><span>Poster presentation, KYCEC conference, Louisville</span><span class="y">2022</span></li>
            </ul>
          </div>
          <div>
            <h3>Education</h3>
            <ul>
              <li><span>MA in Teaching, English as a Second Language, Asbury University</span><span class="y">2025</span></li>
              <li><span>BS, Elementary and Exceptional Child Education, Western Kentucky University</span><span class="y">2022</span></li>
              <li><span>UFLI literacy intervention training</span><span class="y">2025</span></li>
              <li><span>Google Certified Educator, Level 2</span><span class="y">2020</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("#choices button");
  const blank = document.getElementById("blank")!, who = document.getElementById("who")!, statement = document.getElementById("statement")!;
  const made = document.getElementById("made-this") as HTMLAnchorElement, img = document.getElementById("made-img") as HTMLImageElement | null, title = document.getElementById("made-title")!;
  const lift = (slug: string) => document.querySelectorAll(".desk .piece").forEach((p) => p.classList.toggle("chosen", (p as HTMLElement).dataset.slug === slug));
  buttons.forEach((b) => b.addEventListener("click", () => {
    buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    const d = b.dataset;
    blank.textContent = d.end!; who.textContent = d.who!; title.textContent = d.title!; made.href = d.href!;
    if (img && d.img) { img.src = d.img; img.width = +d.w!; img.height = +d.h!; }
    statement.classList.remove("swap"); void statement.offsetWidth; statement.classList.add("swap");
    lift(d.slug!);
  }));
</script>
